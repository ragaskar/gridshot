# GPU exposed to the segmentation service through NVIDIA CDI.
# Use nvidia.com/gpu=all or a specific index/UUID on multi-GPU hosts.
GRIDSHOT_GPU_DEVICE=nvidia.com/gpu=0

# UID:GID the containers run as. scripts/up and scripts/gridshot detect this
# for you; set it only when driving `docker compose` directly.
#
# Rootless engines (Podman, or rootless Docker) map container UID 0 to your
# host user, so 0:0 is what writes files you own. Rootful Docker maps
# identically, where 0:0 would mean real root — keep the 1000:1000 default.
# GRIDSHOT_USER=0:0

# Address the web port binds to. Defaults to 0.0.0.0 (LAN-reachable);
# scripts/up --tailscale sets this to 127.0.0.1 for you.
# GRIDSHOT_BIND_ADDR=0.0.0.0

# Address the segserver port binds to. Defaults to 127.0.0.1 (compose-internal
# only, for a colocated deploy); scripts/up --segserver sets this to 0.0.0.0
# for you, for a multi-host deploy.
# GRIDSHOT_SEGSERVER_BIND_ADDR=127.0.0.1

# Where web/cli reach segserver. Only needed for a multi-host deploy — the
# default resolves segserver's compose-internal hostname, which only works
# when segserver is colocated. scripts/up --frontend requires this to be set.
# GRIDSHOT_SEGSERVER_URL=http://192.168.1.50:8801

# Optional model and runtime settings.
GRIDSHOT_SAM=sam2
GRIDSHOT_INFERENCE_QUEUE_SIZE=2
HF_TOKEN=
